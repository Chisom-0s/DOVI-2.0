# Copy this file to .env and fill in the values
# Do NOT commit .env to source control

# Backend API base URL (no trailing slash)
VITE_API_BASE_URL=http://localhost:8000

# Cloudflare R2 Public Development URL or Custom Domain (e.g. pub-xxxxxxxxxxxx.r2.dev or media.dovishops.com)
VITE_R2_PUBLIC_DOMAIN=

# Smartsupp Live Chat Project Key
VITE_SMARTSUPP_KEY=

# Resend API (https://resend.com/api-keys)
VITE_RESEND_API_KEY=
RESEND_API_KEY=
# Optional sender email address configured in Resend (e.g. onboarding@resend.dev or no-reply@yourdomain.com)
VITE_RESEND_FROM_EMAIL=
RESEND_FROM_EMAIL=
